---
interface Props {
  title?: string;
  message?: string;
  paddingTop?: string; // any css length, eg '4rem'
  paddingBottom?: string;
}

const {
  title = 'How are we doing?',
  message = "We're constantly improving Session Buddy. If you appreciate our work, please take a moment to let us know.",
  paddingTop = '0',
  paddingBottom = '0',
} = Astro.props;
---

<!-- Hidden on mobile devices, since Chrome Web Store reviews require the extension to be installed and Chrome extensions aren't supported on mobile. Padding lives on the wrapper so it's hidden along with the banner. -->

<div
  data-review-banner
  style={`padding-top: ${paddingTop}; padding-bottom: ${paddingBottom}`}
>
  <!-- inline (ie non-bundled) so it runs synchronously, before the banner below is parsed. it flags the device on <html> instead of hiding the banner directly because view transitions re-render the banner but don't re-run this script until after the incoming page is painted. -->

  <script is:inline>
    (() => {
      const flagMobileDevice = () => {
        const userAgent = navigator.userAgent;

        const userAgentData = navigator.userAgentData;

        const isMobile =
          userAgentData?.mobile === true ||
          /android|iphone|ipod|ipad|windows phone|iemobile|blackberry|opera mini|mobile/i.test(
            userAgent,
          ) ||
          // iPadOS 13+ identifies itself as macOS while using touch input
          (/macintosh/i.test(userAgent) && navigator.maxTouchPoints > 1);

        document.documentElement.toggleAttribute('data-mobile-device', isMobile);
      };

      flagMobileDevice();

      // view transitions replace every <html> attribute with those of the incoming page, so reflag on each swap. astro:after-swap runs before that page is painted.
      if (!window.reviewBannerDeviceFlagged) {
        window.reviewBannerDeviceFlagged = true;

        document.addEventListener('astro:after-swap', flagMobileDevice);
      }
    })();
  </script>

  <aside
    aria-label="Review Session Buddy"
    class="review-banner flex flex-col gap-10 sm:flex-row sm:items-center sm:justify-between p-6 sm:p-7 rounded-2xl block-strong-border"
  >
    <div class="sm:max-w-84">
      <strong class="block text-lg text-primaryTextColor">{title}</strong>
      <p class="mt-2! mb-0! leading-6! text-secondaryTextColor">{message}</p>
    </div>
    <a
      href="https://chromewebstore.google.com/detail/session-buddy-tab-bookmar/edacconmaakjimmfgnblocblbcdcpbko/reviews"
      target="_blank"
      rel="noopener"
      class="contained-button w-full sm:w-auto shrink-0 px-6 py-2 text-white! no-underline! whitespace-nowrap"
    >
      <span class="text-base">Review Session Buddy</span>
    </a>
  </aside>
</div>

<style is:global>
  /* covers most mobile devices without js, so it holds even mid view transition swap */
  @media (hover: none) and (pointer: coarse) {
    [data-review-banner] {
      display: none;
    }
  }

  /* catches the rest, eg a tablet paired with a trackpad */
  html[data-mobile-device] [data-review-banner] {
    display: none;
  }
</style>

<style>
  .review-banner {
    background: linear-gradient(
      135deg,
      var(--color-blockStrongBackgroundColor),
      color-mix(
        in srgb,
        var(--color-primaryColor) 8%,
        var(--color-blockBackgroundColor)
      )
    );
  }
</style>
